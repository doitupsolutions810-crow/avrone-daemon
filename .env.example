# --- Provider preset: ollama (free, self-hosted, default) | openclaw | xai | openai | openrouter | custom ---
# Free open-source route: install Ollama (https://ollama.com), then `ollama pull qwen2.5:3b`.
# qwen2.5:3b is the benchmarked default (tools/model_bench.py scored it 100/100 on the
# live squad bench); on a GPU host upgrade to e.g. qwen3.5:9b — one line below.
AVRONE_PROVIDER=ollama
AVRONE_LLM_BASE_URL=http://127.0.0.1:11434/v1
AVRONE_LLM_MODEL=qwen2.5:3b
# Or use the OpenClaw gateway instead:
# AVRONE_LLM_BASE_URL=http://127.0.0.1:18789/v1
# AVRONE_LLM_API_KEY=your-openclaw-gateway-token
# AVRONE_LLM_MODEL=openclaw
# Or use xAI Grok directly:
# AVRONE_LLM_BASE_URL=https://api.x.ai/v1
# AVRONE_LLM_API_KEY=xai-...
# AVRONE_LLM_MODEL=grok-4
# Optional stronger model just for the Lead agent:
# AVRONE_LEAD_MODEL=
# Optional fallbacks, tried in order after the primary (gateway v0.7):
# AVRONE_LLM_FALLBACKS=ollama:llama3.2:3b,openrouter:x-ai/grok-4
# Run with no model at all (demo/tests):
# AVRONE_LLM_MODE=mock

# --- Orchestration ---
AVRONE_DEEP_SQUAD_SIZE=4      # Deep Analysis reviewers (max 6)
AVRONE_MAX_PARALLEL=6         # concurrent model calls
AVRONE_LLM_RETRIES=3
AVRONE_LLM_BACKOFF=1.5
AVRONE_SQUAD_SIZE=4
AVRONE_MAX_STEPS=6
AVRONE_MAX_SPAWN_DEPTH=2

# --- Environment ---
AVRONE_RUNNER=auto            # auto | docker | local
AVRONE_DOCKER_IMAGE=python:3.12-slim
AVRONE_ALLOW_NETWORK=true
AVRONE_AGENTS_CAN_SHELL=true
AVRONE_WORKSPACE=./workspace
AVRONE_DATA_DIR=./data

# --- Admin terminal (leave empty to disable) ---
AVRONE_ADMIN_TOKEN=
AVRONE_HOST=127.0.0.1
AVRONE_PORT=8710

# --- Extensions ---
AVRONE_PLUGINS_DIR=./plugins
AVRONE_MCP_CONFIG=./mcp.json
# AVRONE_SEARCH_PROVIDER=auto   # duckduckgo | brave | tavily
# BRAVE_API_KEY=
# TAVILY_API_KEY=

# --- Fleet (v0.5): link AVRONE servers so agents spawn agents on remote nodes ---
# AVRONE_FLEET_TOKEN=long-random-shared-secret   # required; same on every node
# AVRONE_NODE_ID=edge-1                          # stable, unique per node
# AVRONE_PUBLIC_URL=https://edge-1.example:8000  # how others reach this node
# AVRONE_FLEET_PARENT=https://router.example:8000
# AVRONE_FLEET_MAX_HOPS=3
# AVRONE_FLEET_ALLOW=router,edge-1,edge-2        # optional allowlist of node ids
# AVRONE_FLEET_HEARTBEAT=15

# --- Gateway (v0.7): fallback providers, tried in order after the primary ---
# AVRONE_LLM_FALLBACKS=openrouter:x-ai/grok-4,ollama:llama3.1
# AVRONE_BREAKER_THRESHOLD=3
# AVRONE_BREAKER_COOLDOWN=30

# --- Agent kit (v0.8) ---
# AVRONE_SELF_CHANGES=allow   # allow | log | deny (env_install / logged shell installs)
# AVRONE_SKILLS_DIR=./skills

# --- Self-evolution (v0.9) ---
# AVRONE_SELF_EVOLVE=allow        # allow | deny
# AVRONE_REPO_DIR=.               # repo root AVRONE may propose edits to
# AVRONE_EVOLVE_TEST_CMD=python -m pytest -q

# --- Reconnaissance (v0.10) ---
# AVRONE_RECON=allow              # allow | deny
# AVRONE_RECON_ALLOWLIST=        # comma hosts/suffixes to restrict recon to; empty = any

# --- Fusion blackboard / CycleKernal delivery (opt-in client; nothing polls by itself) ---
# AVRONE_ADMIN_TOKEN_PREVIOUS=   # exact grace token for /api/blackboard only, during rotation
# CK_BASE=http://127.0.0.1:8090
# CK_EVENTS_PATH=/v1/events
# CK_HEALTH_PATH=/health
# CK_FUSION_TOKEN=               # sent as X-Admin-Token; wins over FUSION_TOKEN and AVRONE_ADMIN_TOKEN
# FUSION_TIMEOUT=5
# FUSION_CYCLE_DEADLINE=10       # seconds; 0 disables the per-cycle cap
# FUSION_BREAKER_THRESHOLD=1     # timeouts or refused connections; 500 does not open the breaker
# FUSION_BREAKER_COOLDOWN=30
# FUSION_BACKOFF_BASE=0.5        # seconds, doubles on 429 and dial failure, floored so it cannot spin
# FUSION_BACKOFF_MAX=8
# FUSION_INTERVAL=1              # seconds between 404/405 retries; 429 and 500 use the exponential cap


# Fixed sibling-service bridge targets (optional; no URLs supplied by agents).
AVRONE_PLATFORM_TARGETS_JSON={}
AVRONE_PLATFORM_WRITE_ENABLED=false
# Tenant-scoped Runtime API key; leave empty until Runtime is configured.
AVRONE_BRIDGE_RUNTIME_TOKEN=
AVRONE_BRIDGE_RUNTIME_CAPABILITIES_JSON=[]
