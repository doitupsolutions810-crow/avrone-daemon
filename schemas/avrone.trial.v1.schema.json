{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.avrone.local/avrone.trial.v1.schema.json",
  "title": "AVRONE Trial Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "trial_id", "system", "node", "source", "run_id", "check_id", "check_version", "check_config_sha256", "attempt_id", "outcome", "failed"],
  "properties": {
    "schema": {"const": "avrone.trial/v1"},
    "trial_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "system": {"type": "string", "minLength": 1, "maxLength": 64},
    "node": {"type": "string", "minLength": 1, "maxLength": 63},
    "source": {"type": "string", "minLength": 1, "maxLength": 128},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "check_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "check_version": {"type": "string", "minLength": 1, "maxLength": 256},
    "check_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "outcome": {"type": "string", "enum": ["pass", "fail", "skipped", "cancelled", "timed_out", "inconclusive"]},
    "failed": {"type": ["boolean", "null"]}
  }
}
